# LexAudit AI — backend dev environment example.
# Copy to .env and fill real secrets. NEVER commit real secrets.
# Secrets come only from env / secret manager; missing secret -> server refuses to start.

# --- Server ---
APP_ENV=development
BIND_ADDR=0.0.0.0:8080
PUBLIC_BASE_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Database (PostgreSQL 16 + pgvector + pg_trgm + unaccent) ---
DATABASE_URL=postgres://lexaudit:lexaudit_dev@localhost:5432/lexaudit

# --- Auth (B3: argon2 / jsonwebtoken 15 min / refresh hash in DB / Strict cookie + CSRF) ---
# 256-bit+ random string in production. Empty -> server refuses to start.
JWT_SECRET=change-me-to-32-bytes-minimum-dev-only
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
CSRF_SECRET=change-me-csrf-dev-only
# Comma-separated origins for CORS. Production: explicit frontend origin(s) only.
# (CORS: only concrete origins — BACKEND.md section 11)

# --- S3-compatible storage (MinIO on-prem, B4) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-central-1
S3_BUCKET=lexaudit-dev
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# --- Model serving (internal network, OpenAI-compatible) ---
MODEL_SERVING_BASE_URL=http://localhost:8001

# --- Observability ---
RUST_LOG=info,lexaudit=debug
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
PROMETHEUS_LISTEN_ADDR=0.0.0.0:9090

# --- Data residency note ---
# Production data stays inside Azerbaijan ("Ferdî melumatlar haqqında" Qanun).
