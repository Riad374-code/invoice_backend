# LexAudit AI — backend dev environment example.
# Copy to .env and fill real secrets. NEVER commit real secrets.
# Secrets come only from env / secret manager; missing or weak secret -> server refuses to start.

# --- Server ---
APP_ENV=development                 # development | test | production
BIND_ADDR=0.0.0.0:8080
PUBLIC_BASE_URL=http://localhost:8080
# Concrete origins only (no "*", no trailing slash). Comma-separated.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# true only behind a trusted reverse proxy (enables X-Forwarded-For for rate limiting/audit IPs)
TRUST_PROXY=false
LOG_LEVEL=info

# --- Database (PostgreSQL 16 + pgvector + pg_trgm + unaccent) ---
# Leave empty in development to use an IN-MEMORY database (no Docker needed; data is lost on exit).
DATABASE_URL=postgres://lexaudit:lexaudit_dev@localhost:5432/lexaudit
# Defaults: true in development/test, false in production (run `npm run migrate` as a deploy step)
# AUTO_MIGRATE=true

# --- Auth (B3: argon2id / JWT 15 min / refresh hash in DB / Strict cookie + CSRF) ---
# >= 32 characters, must differ from each other. Generate: openssl rand -base64 48
JWT_SECRET=change-me-to-32-bytes-minimum-dev-only
CSRF_SECRET=change-me-csrf-secret-32-bytes-min-dev
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
LOGIN_RATE_LIMIT_PER_MINUTE=10
GLOBAL_RATE_LIMIT_PER_MINUTE=600

# --- Dev bootstrap (development only): creates a company + admin user on first start ---
# DEV_ADMIN_EMAIL=admin@lexaudit.local
# DEV_ADMIN_PASSWORD=choose-a-dev-password

# --- Files (B4) ---
# Upload size limit in bytes (max 26214400 = clamd StreamMaxLength)
MAX_UPLOAD_BYTES=20971520
# Antivirus (ClamAV clamd). Production requires CLAMAV_HOST unless CLAMAV_DISABLED=true is set explicitly.
# Uploads fail closed (503) while clamd is unreachable.
# CLAMAV_HOST=localhost
# CLAMAV_PORT=3310
# CLAMAV_DISABLED=false
# Background jobs (Postgres SKIP LOCKED queue). Set JOBS_ENABLED=false to run API-only instances.
JOBS_ENABLED=true
JOBS_POLL_INTERVAL_MS=1000

# --- S3-compatible storage (MinIO on-prem, B4) ---
# Leave S3_* empty in development to use IN-MEMORY storage. Production requires bucket/region/keys.
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-central-1
S3_BUCKET=lexaudit-dev
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# --- Model serving (internal network, OpenAI-compatible) ---
MODEL_SERVING_BASE_URL=http://localhost:8001

# --- Observability ---
# Traces (OTLP/HTTP). Empty = disabled.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Prometheus /metrics on a separate internal port. Empty = disabled.
# PROMETHEUS_LISTEN_ADDR=0.0.0.0:9090

# --- Data residency note ---
# Production data stays inside Azerbaijan ("Fərdi məlumatlar haqqında" Qanun).

# Python RAG/OCR sidecar (modules/lexaudit_rag/service.py): Tax Code search, receipt OCR + search.
# RAG_OCR_TOKEN must equal LEXAUDIT_SERVICE_TOKEN of the sidecar. Both required to enable.
RAG_OCR_BASE_URL=
RAG_OCR_TOKEN=

# Demo/nümunə məlumat (deploy): ayrı "Demo MMC" şirkəti (VÖEN 0000000001), istifadəçilər
# admin|accountant|approver|viewer@demo.lexaudit.local, nümunə qaimələr. Real şirkətləri məhdudlaşdırmır.
# SEED_DEMO_DATA=true
# DEMO_PASSWORD=choose-a-12+-char-password
